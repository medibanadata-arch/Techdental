{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/app/*"],
      "@/components/*": ["src/app/Components/*"],
      "@inertiajs/react": ["src/lib/inertia.tsx"],
      "@inertiajs/core": ["src/lib/inertia-core.ts"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
