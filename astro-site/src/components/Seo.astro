---
import { SITE_URL, trimDescription } from '../lib/shared';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  canonical?: string;
  image?: string;
  type?: string;
  robots?: string;
  alternates?: Record<string, string | undefined>;
  schema?: any;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  keywords?: string;
  noSuffix?: boolean;
  lang?: string;
  /** Archived WordPress Open Graph / Twitter maps (legacy pages). */
  og?: Record<string, string>;
  twitter?: Record<string, string>;
  hreflang?: Array<{ lang?: string; href?: string }>;
}

const {
  title = 'Tech Dental Care | Best Dental Clinic in Dhaka, Bangladesh',
  description,
  path,
  canonical,
  image = '/images/og-default.jpg',
  type = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  alternates,
  schema,
  publishedTime,
  modifiedTime,
  author,
  section,
  keywords,
  noSuffix = false,
  lang = 'en',
  og,
  twitter,
  hreflang,
} = Astro.props as Props;

const fullTitle = noSuffix || /tech dental/i.test(title) ? title : `${title} | Tech Dental Care`;
const desc = trimDescription(description);
const canonicalUrl = canonical || `${SITE_URL}${path || Astro.url.pathname}`;
const imageUrl = /^https?:\/\//i.test(image) ? image : `${SITE_URL}${image.startsWith('/') ? '' : '/'}${image}`;
const isBn = lang === 'bn';
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const ogMap = og || {};
const twitterMap = twitter || {};
const ogType = ogMap['og:type'] || type;
const ogTitle = ogMap['og:title'] || fullTitle;
const ogDescription = ogMap['og:description'] || desc;
const ogUrl = ogMap['og:url'] || canonicalUrl;
const ogImage = ogMap['og:image'] || imageUrl;
const twitterCard = twitterMap['twitter:card'] || 'summary_large_image';
const twitterTitle = twitterMap['twitter:title'] || fullTitle;
const twitterDescription = twitterMap['twitter:description'] || desc;
const twitterImage = twitterMap['twitter:image'] || imageUrl;
const OG_KNOWN = ['og:type', 'og:title', 'og:description', 'og:url', 'og:image', 'og:image:alt', 'og:site_name', 'og:locale'];
const TWITTER_KNOWN = ['twitter:card', 'twitter:title', 'twitter:description', 'twitter:image'];
const extraOg = Object.entries(ogMap).filter(([key, value]) => !OG_KNOWN.includes(key) && value !== '');
const extraTwitter = Object.entries(twitterMap).filter(([key, value]) => !TWITTER_KNOWN.includes(key) && value !== '');
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
{keywords && <meta name="keywords" content={keywords} />}
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />
{alternates?.en && <link rel="alternate" hreflang="en" href={alternates.en} />}
{alternates?.bn && <link rel="alternate" hreflang="bn" href={alternates.bn} />}
{alternates?.['x-default'] && <link rel="alternate" hreflang="x-default" href={alternates['x-default']} />}
{(hreflang || []).map((item) =>
  item?.href && item?.lang ? <link rel="alternate" hreflang={item.lang} href={item.href} /> : null
)}

<meta property="og:site_name" content="Tech Dental Care" />
<meta property="og:locale" content={isBn ? 'bn_BD' : 'en_US'} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogTitle} />
{extraOg.map(([key, value]) => <meta property={key} content={value} />)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}
{section && <meta property="article:section" content={section} />}

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={twitterTitle} />
<meta name="twitter:description" content={twitterDescription} />
<meta name="twitter:image" content={twitterImage} />
{extraTwitter.map(([key, value]) => <meta name={key} content={value} />)}

{schemas.map((item) => (
  <script type="application/ld+json" set:html={JSON.stringify(item)} />
))}
