---
import '../styles/app.css';
import Seo from '../components/Seo.astro';
import { siteSettings } from '../lib/shared';

interface Props {
  seo?: Record<string, any>;
  lang?: string;
  bodyClass?: string;
}

const { seo = {}, lang = 'en', bodyClass = '' } = Astro.props;
const settings = siteSettings();
const favicon = settings?.favicon || '/favicon.ico';
const faviconType = /\.webp$/i.test(favicon)
  ? 'image/webp'
  : /\.png$/i.test(favicon)
    ? 'image/png'
    : /\.svg$/i.test(favicon)
      ? 'image/svg+xml'
      : 'image/x-icon';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} lang={lang} />

    <link rel="icon" type={faviconType} href={`${favicon}?v=4`} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=4" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <link rel="shortcut icon" href="/favicon.ico?v=4" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap"
    />
    <link rel="preload" href="/fonts/solaiman-lipi/solaimanlipi-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  </head>
  <body class={`bg-white text-gray-900 antialiased selection:bg-rose-900 selection:text-white font-sans ${bodyClass}`}>
    <slot />
  </body>
</html>
