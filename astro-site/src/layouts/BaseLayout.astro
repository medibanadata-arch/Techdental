---
import '../styles/app.css';
import Seo from '../components/Seo.astro';
import { siteSettings } from '../lib/shared';

interface Props {
  seo?: Record<string, any>;
  lang?: string;
  bodyClass?: string;
}

const { seo = {}, lang = 'en', bodyClass = '' } = Astro.props;
const settings = siteSettings();
const favicon = settings?.favicon || '/favicon.ico';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} lang={lang} />

    <link rel="icon" type="image/x-icon" href={favicon} />
    <link rel="shortcut icon" href={favicon} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap"
    />
    <link rel="preload" href="/fonts/solaiman-lipi/solaimanlipi-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  </head>
  <body class={`bg-white text-gray-900 antialiased selection:bg-rose-900 selection:text-white font-sans ${bodyClass}`}>
    <slot />
  </body>
</html>
