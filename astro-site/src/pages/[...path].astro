---
import LegacyEntity from '../components/LegacyEntity.astro';
import { notFoundResponse } from '../lib/notFound';
import { materializeLegacy, canonicalMismatch, canonicalPathOf, type LegacyRenderResult } from '../lib/legacyRender';
import {
  encodeLocation,
  findLegacyPage,
  isRemovedPath,
  lookupEntity,
  matchOldPattern,
  matchSpecialRedirect,
  renderLegacyPage,
  renderMappedEntity,
  type LegacyRender,
} from '../lib/legacy';

const rawPath = Astro.url.pathname;

const notFound = () => notFoundResponse();
const go = (location: string, status = 301) =>
  new Response(null, { status, headers: { Location: encodeLocation(location) } });

let response: Response | null = null;
let renderResult: LegacyRenderResult | null = null;
let handled = false;

const use = (result: LegacyRender): boolean => {
  const materialized = materializeLegacy(result);
  if (!materialized) return false;
  handled = true;
  if (materialized instanceof Response) {
    response = materialized;
    return true;
  }
  renderResult = materialized;
  return true;
};

if (isRemovedPath(rawPath)) return notFound();

const special = matchSpecialRedirect(rawPath);
if (special) {
  if (special.resolve) {
    const entity = lookupEntity(rawPath);
    if (!(entity && use(renderMappedEntity(rawPath, entity)))) {
      const archived = findLegacyPage(rawPath);
      if (archived) use(renderLegacyPage(rawPath, archived));
    }
  }
  if (!handled) return go(special.location, 301);
} else {
  const oldPattern = matchOldPattern(rawPath);
  if (oldPattern) {
    const entity = lookupEntity(oldPattern.candidatePath);
    if (!(entity && use(renderMappedEntity(oldPattern.candidatePath, entity)))) {
      const archived = findLegacyPage(oldPattern.candidatePath) || findLegacyPage(rawPath);
      if (archived) use(renderLegacyPage(rawPath, archived));
    }
    // A renamed section (blog, medicine) keeps its old item URLs working with a
    // single 301 to the canonical item, never a duplicate render.
    if (renderResult && canonicalMismatch(renderResult.seo, rawPath)) {
      const canonical = canonicalPathOf(renderResult.seo);
      renderResult = null;
      handled = false;
      if (canonical) return go(canonical, 301);
    }
    if (!handled) return go(oldPattern.fallback, 301);
  } else {
    const entity = lookupEntity(rawPath);
    if (entity) use(renderMappedEntity(rawPath, entity));

    if (!handled) {
      const archived = findLegacyPage(rawPath);
      if (archived) use(renderLegacyPage(rawPath, archived));
    }

    if (!handled) return notFound();
  }
}

if (response) return response;
if (!renderResult) return notFound();

// Exactly one URL per page: a legacy alias that resolves to a page with a
// different canonical must 404 instead of duplicating that page.
if (canonicalMismatch(renderResult.seo, rawPath)) return notFound();
---

<LegacyEntity result={renderResult} />
