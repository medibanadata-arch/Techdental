---
import AdminShell from '../../../layouts/AdminShell.astro';
import Page from '../../../app/wrappers/FeaturedImages_EditPage';
import { adminPagePayload } from '../../../lib/admin/http';
import { all, get, model, models } from '../../../lib/db';

const { id } = Astro.params;
const row = get('SELECT * FROM featured_images WHERE id = ?', [Number(id)]);
if (!row) return new Response('Not Found', { status: 404 });

const image = model('featured_images', row);
const locations = models('locations', all('SELECT * FROM locations ORDER BY sort_order ASC'));
const page = adminPagePayload(Astro.request, 'FeaturedImages/Edit', { image, locations });
---

<AdminShell title={`Edit Slider Image #${image.id} - Tech Dental`}>
  <Page client:load page={page} />
</AdminShell>
