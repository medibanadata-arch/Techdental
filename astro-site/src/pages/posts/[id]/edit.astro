---
import AdminShell from '../../../layouts/AdminShell.astro';
import Page from '../../../app/wrappers/Posts_EditPage';
import { adminPagePayload } from '../../../lib/admin/http';
import { all, get, model, models } from '../../../lib/db';

const { id } = Astro.params;
const row = get('SELECT * FROM posts WHERE id = ?', [Number(id)]);
if (!row) return new Response('Not Found', { status: 404 });

const post = model('posts', row);
const mediaList = models('media', all('SELECT * FROM media ORDER BY created_at DESC'));
const page = adminPagePayload(Astro.request, 'Posts/Edit', { post, mediaList });
---

<AdminShell title={`Edit Post: ${post.title}`}>
  <Page client:load page={page} />
</AdminShell>
