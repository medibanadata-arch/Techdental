---
import AdminShell from '../../layouts/AdminShell.astro';
import Page from '../../app/wrappers/Posts_CreatePage';
import { adminPagePayload } from '../../lib/admin/http';
import { all, models } from '../../lib/db';

const mediaList = models('media', all('SELECT * FROM media ORDER BY created_at DESC'));
const page = adminPagePayload(Astro.request, 'Posts/Create', { mediaList });
---

<AdminShell title="Add New Post">
  <Page client:load page={page} />
</AdminShell>
