---
import AdminShell from '../../layouts/AdminShell.astro';
import Page from '../../app/wrappers/Posts_CategoriesPage';
import { adminPagePayload } from '../../lib/admin/http';
import { all, models } from '../../lib/db';

const categories = models('categories', all('SELECT * FROM categories ORDER BY created_at DESC'));
const page = adminPagePayload(Astro.request, 'Posts/Categories', { categories });
---

<AdminShell title="Categories - Tech Dental">
  <Page client:load page={page} />
</AdminShell>
