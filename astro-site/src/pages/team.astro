---
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from '../app/wrappers/Team_PublicIndexPage';
import { pagePayload } from '../lib/shared';
import { teamIndexProps, teamIndexSeo } from '../lib/pages/people';

const props = teamIndexProps();
const page = pagePayload('Team/PublicIndex', props, '/team');
const seo = teamIndexSeo();
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
