---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Page from '../../../app/wrappers/Branch_PublicShowPage';
import { pagePayload } from '../../../lib/shared';
import { branchShowProps, branchShowSeo } from '../../../lib/pages/branches';

const { slug = '' } = Astro.params;
const props = branchShowProps(String(slug), true);
if (!props) return new Response('Not Found', { status: 404 });
const page = pagePayload('Branch/PublicShow', props, `/bn/branch/${slug}`, 'bn');
const seo = branchShowSeo(props.branch, true);
---

<BaseLayout seo={seo} lang="bn">
  <Page client:load page={page} />
</BaseLayout>
