---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Page from '../../app/wrappers/PatientRights_PublicShowPage';
import { pagePayload } from '../../lib/shared';
import { patientRightsProps, patientRightsSeo } from '../../lib/pages/info';

const props = patientRightsProps(true);
const page = pagePayload('PatientRights/PublicShow', props, '/bn/patient-rights', 'bn');
const seo = patientRightsSeo(props.settings, true);
---

<BaseLayout seo={seo} lang="bn">
  <Page client:load page={page} />
</BaseLayout>
