---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Page from '../../app/wrappers/Services_PublicIndexPage';
import { pagePayload } from '../../lib/shared';
import { servicesIndexProps, servicesIndexSeo, servicesIndexSchema } from '../../lib/pages/services';

const isBn = true;
const props = servicesIndexProps(isBn);
const page = pagePayload('Services/PublicIndex', props, '/bn/services', 'bn');
const seo = { ...servicesIndexSeo(isBn), schema: servicesIndexSchema(props.services, isBn) };
---

<BaseLayout seo={seo} lang="bn">
  <Page client:load page={page} />
</BaseLayout>
