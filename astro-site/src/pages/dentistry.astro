---
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from '../app/wrappers/Blog_PublicIndexPage';
import { pagePayload } from '../lib/shared';
import { blogIndexProps, blogIndexSeo, blogIndexSchema } from '../lib/pages/blog';

const props = blogIndexProps(false);
const page = pagePayload('Blog/PublicIndex', props, '/dentistry');
const seo = { ...blogIndexSeo(false, false), schema: blogIndexSchema(props.posts, false, false) };
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
