---
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from '../app/wrappers/Doctors_PublicIndexPage';
import { pagePayload } from '../lib/shared';
import { doctorsIndexProps, doctorsIndexSeo } from '../lib/pages/people';

const props = doctorsIndexProps();
const page = pagePayload('Doctors/PublicIndex', props, '/doctors');
const seo = doctorsIndexSeo(props.settings);
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
