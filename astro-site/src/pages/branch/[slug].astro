---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Page from '../../app/wrappers/Branch_PublicShowPage';
import { pagePayload } from '../../lib/shared';
import { branchShowProps, branchShowSeo } from '../../lib/pages/branches';

const { slug = '' } = Astro.params;
const props = branchShowProps(String(slug));
if (!props) return new Response('Not Found', { status: 404 });
const page = pagePayload('Branch/PublicShow', props, `/branch/${slug}`);
const seo = branchShowSeo(props.branch);
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
