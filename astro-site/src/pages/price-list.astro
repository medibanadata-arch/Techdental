---
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from '../app/wrappers/PriceList_PublicIndexPage';
import { pagePayload } from '../lib/shared';
import { priceListProps, priceListSeo } from '../lib/pages/info';

const props = priceListProps(false);
const page = pagePayload('PriceList/PublicIndex', props, '/price-list');
const seo = priceListSeo(props.settings);
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
