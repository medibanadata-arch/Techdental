---
import AdminShell from '../../layouts/AdminShell.astro';
import Page from '../../app/wrappers/CustomPages_ShowPage';
import { adminPagePayload } from '../../lib/admin/http';
import { all, get, model } from '../../lib/db';

const { id } = Astro.params;
const row = get('SELECT * FROM pages WHERE id = ?', [Number(id)]);
if (!row) return new Response('Not Found', { status: 404 });

const item = model('pages', row);

const REDIRECT_MAP: Record<string, string> = {
  home: '/',
  services: '/services',
  'price-list': '/price-list',
  doctors: '/doctors',
  medicines: '/medicines',
  branches: '/branches',
  'branch-mirpur': '/branch/mirpur',
  mirpur: '/branch/mirpur',
  'branch-uttara': '/branch/uttara',
  uttara: '/branch/uttara',
  'branch-badda': '/branch/badda',
  badda: '/branch/badda',
  'branch-jatrabari': '/branch/jatrabari',
  jatrabari: '/branch/jatrabari',
  about: '/about',
  team: '/team',
  blog: '/blog',
  appointment: '/appointment',
};
if (REDIRECT_MAP[String(item.slug)]) return Astro.redirect(REDIRECT_MAP[String(item.slug)], 302);

const page = adminPagePayload(Astro.request, 'CustomPages/Show', {
  item,
  locations: all('SELECT * FROM locations'),
  nav_menu: get('SELECT * FROM nav_menus LIMIT 1') || null,
});
---

<AdminShell title={String(item.title ?? 'Page')}>
  <Page client:load page={page} />
</AdminShell>
