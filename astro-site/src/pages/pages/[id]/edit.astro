---
import AdminShell from '../../../layouts/AdminShell.astro';
import Page from '../../../app/wrappers/CustomPages_EditPage';
import { adminPagePayload } from '../../../lib/admin/http';
import { get, model } from '../../../lib/db';

const { id } = Astro.params;
const row = get('SELECT * FROM pages WHERE id = ?', [Number(id)]);
if (!row) return new Response('Not Found', { status: 404 });

const page = model('pages', row);
const payload = adminPagePayload(Astro.request, 'CustomPages/Edit', { page });
---

<AdminShell title={`Edit Page: ${page.title} - Tech Dental`}>
  <Page client:load page={payload} />
</AdminShell>
