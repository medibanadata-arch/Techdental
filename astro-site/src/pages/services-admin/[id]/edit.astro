---
import AdminShell from '../../../layouts/AdminShell.astro';
import Page from '../../../app/wrappers/Services_AdminEditPage';
import { adminPagePayload } from '../../../lib/admin/http';
import { get, model } from '../../../lib/db';

const { id } = Astro.params;
const row = get('SELECT * FROM services WHERE id = ?', [Number(id)]);
if (!row) return new Response('Not Found', { status: 404 });

const item = model('services', row);
const page = adminPagePayload(Astro.request, 'Services/AdminEdit', { item });
---

<AdminShell title={`Edit Service: ${item.title}`}>
  <Page client:load page={page} />
</AdminShell>
