---
import AdminShell from '../../../layouts/AdminShell.astro';
import Page from '../../../app/wrappers/Team_AdminEditPage';
import { adminPagePayload } from '../../../lib/admin/http';
import { get, model } from '../../../lib/db';

const { id } = Astro.params;
const row = get('SELECT * FROM team_members WHERE id = ?', [Number(id)]);
if (!row) return new Response('Not Found', { status: 404 });

const item = model('team_members', row);
const page = adminPagePayload(Astro.request, 'Team/AdminEdit', { item });
---

<AdminShell title={`Edit Member: ${item.name}`}>
  <Page client:load page={page} />
</AdminShell>
