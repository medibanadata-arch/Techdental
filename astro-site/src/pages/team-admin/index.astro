---
import AdminShell from '../../layouts/AdminShell.astro';
import Page from '../../app/wrappers/Team_AdminIndexPage';
import { adminPagePayload } from '../../lib/admin/http';
import { all, models } from '../../lib/db';

const data = models('team_members', all('SELECT * FROM team_members ORDER BY sort_order'));
const page = adminPagePayload(Astro.request, 'Team/AdminIndex', { data });
---

<AdminShell title="Corporate Team Admin - Tech Dental">
  <Page client:load page={page} />
</AdminShell>
