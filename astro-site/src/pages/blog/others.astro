---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Page from '../../app/wrappers/Blog_PublicIndexPage';
import { pagePayload } from '../../lib/shared';
import { blogOthersProps, blogIndexSeo, blogIndexSchema } from '../../lib/pages/blog';

const props = blogOthersProps(false);
const page = pagePayload('Blog/PublicIndex', props, '/blog/others');
const seo = { ...blogIndexSeo(false, true), schema: blogIndexSchema(props.posts, false, true) };
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
