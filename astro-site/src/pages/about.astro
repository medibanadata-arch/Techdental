---
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from '../app/wrappers/About_PublicIndexPage';
import { pagePayload } from '../lib/shared';
import { aboutProps, aboutSeo } from '../lib/pages/people';

const props = aboutProps();
const page = pagePayload('About/PublicIndex', props, '/about');
const seo = aboutSeo(props.content);
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
