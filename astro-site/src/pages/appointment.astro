---
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from '../app/wrappers/BookAppointment_PublicIndexPage';
import { pagePayload } from '../lib/shared';
import { appointmentProps, appointmentSeo } from '../lib/pages/info';

const props = appointmentProps();
const page = pagePayload('BookAppointment/PublicIndex', props, '/appointment');
const seo = appointmentSeo();
---

<BaseLayout seo={seo} lang="en">
  <Page client:load page={page} />
</BaseLayout>
